<?xml version="1.0" encoding="utf-8"?>
<!--
  Languages the app ships translations for. Listing them here makes the
  per-app language picker appear in Android 13+ system settings, alongside the
  in-app picker under Settings → Appearance → Language.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
    <locale android:name="ta" />
    <locale android:name="hi" />
</locale-config>
